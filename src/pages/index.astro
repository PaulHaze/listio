---
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import { getIndex } from '@/storage/lists';
import { MAX_NAME_LENGTH } from '@/api/http';

export const prerender = false;
const lists = await getIndex(env.LISTIO);
const changed = Astro.url.searchParams.get('changed') === '1';
---

<Layout
	title="Combined Lists · Listio"
	description="Build curated movie and TV Combined Lists for Nuvio."
>
	<main class="listio-main">
		<header class="page-heading">
			<h1>Combined Lists</h1>
			<p>Create and curate movie and TV lists for Nuvio.</p>
		</header>
		{changed && (
			<p class="notice" role="status">
				Refresh the Listio addon in Nuvio to see this change
			</p>
		)}
		<p>
			<a href="/import">Import from text</a>
			{' · '}
			<a href="/export">Export collection</a>
		</p>
		<list-manager>
			<p class="error" role="alert" hidden></p>
			<div class="form-row new-entries">
				<details class="panel new-list" name="new-entry">
					<summary>+ New list</summary>
					<form data-action="create">
						<label for="new-name">Combined List name</label>
						<div class="form-row">
							<input
								id="new-name"
								name="name"
								required
								maxlength={MAX_NAME_LENGTH}
								placeholder="Weekend favourites"
							/>
							<button type="submit">Create list</button>
						</div>
					</form>
				</details>
				<details class="panel new-list" name="new-entry">
					<summary>+ New collection</summary>
					<form method="GET" action="/import">
						<label for="new-collection">Collection title</label>
						<input
							id="new-collection"
							name="collection"
							required
							maxlength={MAX_NAME_LENGTH}
							pattern=".*\S.*"
						/>
						<button type="submit">Paste lists</button>
					</form>
				</details>
			</div>
			{lists.length === 0 ? (
				<p class="empty-state">
					No Combined Lists yet. Create your first list to get started.
				</p>
			) : (
				<ul class="list-grid">
					{lists.map((list) => (
						<li class="panel">
							<div class="list-heading">
								<a
									class="list-name"
									href={`/lists/${encodeURIComponent(list.id)}`}
								>
									{list.name}
								</a>
								<p>
									{list.count} {list.count === 1 ? 'Title' : 'Titles'}
								</p>
							</div>
							<label class="home-toggle">
								<input
									type="checkbox"
									data-home={list.id}
									checked={list.showOnHome === true}
								/>
								Show on Nuvio home
							</label>
							<div class="list-actions">
								<details>
									<summary>Rename</summary>
									<form data-action="rename" data-id={list.id}>
										<label for={`name-${list.id}`}>Combined List name</label>
										<div class="form-row">
											<input
												id={`name-${list.id}`}
												name="name"
												value={list.name}
												required
												maxlength={MAX_NAME_LENGTH}
											/>
											<button type="submit">Save name</button>
										</div>
									</form>
								</details>
								<button
									type="button"
									class="danger"
									data-delete={list.id}
									data-name={list.name}
								>
									Delete
								</button>
							</div>
						</li>
					))}
				</ul>
			)}
		</list-manager>
	</main>
</Layout>

<script>
	class ListManager extends HTMLElement {
		connectedCallback() {
			// Show the refresh notice once, not again on reload or from a bookmark.
			const url = new URL(window.location.href);
			if (url.searchParams.has('changed')) {
				url.searchParams.delete('changed');
				history.replaceState(history.state, '', url);
			}
			this.addEventListener('submit', (event) => {
				const form = event.target;
				if (!(form instanceof HTMLFormElement)) return;
				if (!['create', 'rename'].includes(form.dataset.action ?? '')) return;
				event.preventDefault();
				const name = new FormData(form).get('name');
				if (typeof name !== 'string' || !name.trim()) {
					this.showError('Enter a Combined List name.');
					return;
				}
				const create = form.dataset.action === 'create';
				void this.save(
					create
						? '/api/lists'
						: `/api/lists/${encodeURIComponent(form.dataset.id!)}`,
					create ? 'POST' : 'PATCH',
					{ name }
				);
			});
			this.addEventListener('change', (event) => {
				const toggle = event.target;
				if (!(toggle instanceof HTMLInputElement) || !toggle.dataset.home)
					return;
				void this.save(
					`/api/lists/${encodeURIComponent(toggle.dataset.home)}`,
					'PATCH',
					{ showOnHome: toggle.checked }
				).then((saved) => {
					if (!saved) toggle.checked = !toggle.checked;
				});
			});
			this.addEventListener('click', (event) => {
				const button =
					event.target instanceof Element
						? event.target.closest<HTMLButtonElement>('[data-delete]')
						: null;
				if (
					!button ||
					!window.confirm(
						`Delete “${button.dataset.name}”? This cannot be undone.`
					)
				)
					return;
				void this.save(
					`/api/lists/${encodeURIComponent(button.dataset.delete!)}`,
					'DELETE'
				);
			});
		}

		showError(message: string) {
			const error = this.querySelector<HTMLElement>('[role="alert"]')!;
			error.textContent = message;
			error.hidden = false;
		}

		async save(
			url: string,
			method: string,
			body?: { name: string } | { showOnHome: boolean }
		): Promise<boolean> {
			const controls = this.querySelectorAll<
				HTMLInputElement | HTMLButtonElement
			>('input, button');
			if (this.hasAttribute('aria-busy')) return false;
			this.setAttribute('aria-busy', 'true');
			controls.forEach((control) => {
				control.disabled = true;
			});
			try {
				const response = await fetch(url, {
					method,
					headers: { 'Content-Type': 'application/json' },
					body: body ? JSON.stringify(body) : undefined,
				});
				const data =
					response.status === 204
						? null
						: ((await response.json().catch(() => null)) as {
								id: string;
								error?: string;
							} | null);
				if (!response.ok)
					throw new Error(data?.error || 'Unable to save this change.');
				window.location.assign(
					method === 'POST'
						? `/lists/${encodeURIComponent(data!.id)}?created=1`
						: '/?changed=1'
				);
				return true;
			} catch (error) {
				this.showError(
					error instanceof Error
						? error.message
						: 'Unable to save this change. Please try again.'
				);
				this.removeAttribute('aria-busy');
				controls.forEach((control) => {
					control.disabled = false;
				});
				return false;
			}
		}
	}
	customElements.define('list-manager', ListManager);
</script>
