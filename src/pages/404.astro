---
import Layout from '@/layouts/Layout.astro';
---

<Layout
	title="Page not found"
	description="The page you requested could not be found."
>
	<main class="flex min-h-screen flex-col items-center justify-center gap-6 text-center">
		<h1 class="font-bold tracking-tight">404</h1>
		<p class="text-xl">Sorry, we couldn't find that page.</p>
		<a href="/" class="text-primary underline underline-offset-4">
			Go back home
		</a>
	</main>
</Layout>
