---
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import { getList } from '@/storage/lists';
import Editor from '@/components/editor/Editor';

export const prerender = false;
const id = Astro.params.id!;
const list = await getList(env.LISTIO, id);
if (!list) Astro.response.status = 404;
const created = Astro.url.searchParams.get('created') === '1';
---

<Layout title={`${list?.name ?? 'Combined List not found'} · Listio`}>
	<main class="listio-main">
		<a href="/">← Combined Lists</a>
		{list ? (
			<>
				<header class="page-heading">
					<h1>{list.name}</h1>
				</header>
				<Editor client:load initialList={list} created={created} />
			</>
		) : (
			<header class="page-heading">
				<h1>Combined List not found</h1>
				<p>
					It may have been deleted. Return home to open another Combined List.
				</p>
			</header>
		)}
	</main>
</Layout>
